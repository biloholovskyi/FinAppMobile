      }
    }
  },
  "enabledMcpjsonServers": [
    "context7"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[post-edit] Files changed - run the post-code sequence (ai/rules/common/post-code-workflow.md): rtk yarn lint, then rtk yarn tsc --noEmit after code changes; rtk yarn agents:check --strict after agent configuration changes'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[session-end] If code or agent configuration changed this session, run the post-code sequence (ai/rules/common/post-code-workflow.md)'"
          }
        ]
      }
    ]
  }
