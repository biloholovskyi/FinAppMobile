{
  "name": "app-skeleton",
  "version": "1.11.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "android:emulator": "node scripts/start-android.mjs",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "api:generate": "orval --config orval.config.ts",
    "api:generate:watch": "orval --config orval.config.ts --watch",
    "agents:check": "node scripts/check-agent-config.mjs --strict"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.96.1",
    "axios": "^1.20.0",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "lucide-react-native": "^1.7.0",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "orval": "7.9.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
