{
  "name": "app-skeleton",
  "version": "1.13.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "android:emulator": "node scripts/start-android.mjs",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "api:generate": "orval --config orval.config.ts",
    "api:generate:watch": "orval --config orval.config.ts --watch",
    "agents:check": "node scripts/check-agent-config.mjs --strict",
    "calendar:check": "node scripts/check-kyiv-calendar.mjs"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "@tanstack/react-query": "^5.96.1",
    "axios": "^1.20.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "lucide-react-native": "^1.7.0",
    "nativewind": "^4.2.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "orval": "7.9.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
